    "x": 28,
    "y": 40,
    "w": 46,
    "align": "center",
    "shadow": 0.45,
    "emphasis": {
      "color": "#F3E8B8",
      "font": "serif",
      "italic": false,
      "scale": 1
    }
  },
  "title": {
    "font": "serif",
    "size": 78,
