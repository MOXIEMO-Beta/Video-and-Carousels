    "boxes": null,
    "dur": 5.5,
    "w": 86,
    "lower": false
  },
  "section": {
    "font": "serif",
    "size": 64,
    "y": 15,
    "align": "center",
    "color": "#FFFFFF",
    "entrance": "type",
    "cps": 32,
    "boxes": null,
    "dur": 4,
    "w": 86,
    "lower": false
  },
  "sub": {
    "font": "hand",
    "size": 48,
    "y": 27,
    "color": "#FFFFFF"
  },
  "zoom": {
    "pulse": {
      "scale": 1.16,
      "dur": 1.7,
      "every": 7
    }
