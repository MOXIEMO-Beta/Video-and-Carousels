{
  "id": "editorial",
  "name": "Editorial serif + proof cards",
  "best_for": "Results stories, launch breakdowns, myth-busting, case studies. Long (95-175 s) talking-head reels that need credibility proof and chaptered sections.",
  "members": [
    "v3",
    "v5",
    "v8",
    "v10"
  ],
  "fonts": {
    "serif": "Instrument Serif",
    "sans": "Jost",
    "body": "Inter",
    "hand": "Gaegu",
    "display": "Instrument Serif"
  },
  "colors": {
    "text": "#FFFFFF",
    "cream": "#F6F1E7",
    "tint": "#F3E8B8",
    "card": "#FFFFFF",
    "cardInk": "#111111",
    "accent": "#F3E8B8"
  },
  "captions": {
    "mode": "word",
    "case": "sentence",
    "font": "serif",
    "size": 42,
