  "notes": "Captions sit left of the face at a fixed anchor (v5, v8, v10: x~26-30%, y~39-40%); centred variants exist (v3 y~51%). Static top-band title held 4-6.5 s, then swapped for typed chapter headers. Chapter headers and sub-lines use thin handwriting. Punch-in pulses of ~1.16x for 1.4-2 s every 6-9 s (v3 only; others locked off).",
  "cta": {
    "font": "serif",
    "weight": 400,
    "size": 66,
    "case": "none",
    "tracking": -0.01,
    "color": "#FFFFFF",
    "lead": {
      "font": "hand",
      "size": 42,
      "case": "none",
      "color": "#FFFFFF"
    },
    "after": {
      "font": "hand",
      "size": 42,
      "color": "#FFFFFF"
    }
  },
  "card": {
    "y": 64,
    "w": 54,
    "radius": 9
  },
  "count": {
